# Copy this file to .env and fill in real values locally.
# Never commit .env — it is gitignored.

APP_NAME=Employee AI Assistant
APP_ENV=development
DEBUG=true

API_HOST=0.0.0.0
API_PORT=8000

FRONTEND_ORIGIN=http://localhost:5500
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:8000,http://127.0.0.1:8000

# --- LLM (Day 2: used to generate grounded RAG answers) ---
# Get a free Gemini API key at https://aistudio.google.com/apikey
# If left blank, the app still starts and /api/health still works, but
# /api/chat will return a clear "AI answer-generation service is
# unavailable" message instead of crashing.
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
LLM_API_KEY=

# --- Documents / Embeddings / vector store (Day 2) ---
# Leave these commented out to use the built-in defaults, which resolve to
# absolute paths (<project_root>/documents, <project_root>/vector_store)
# computed from the code's own location — this makes them work correctly
# regardless of whether you run commands from the project root or from
# backend/. Only uncomment if you genuinely want a different location.
# DOCUMENTS_DIRECTORY=./documents
# CHROMA_PERSIST_DIRECTORY=./vector_store
CHROMA_COLLECTION_NAME=company_documents
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Retrieval (Day 2) ---
TOP_K=3
# Smaller = more relevant (cosine distance). See README "No-Answer /
# Confidence Strategy" before changing this — calibrate with
# scripts/inspect_retrieval.py against your actual documents first.
RETRIEVAL_SCORE_THRESHOLD=1.2

# --- Chunking (Day 2) ---
# See README "Chunking Strategy" for why these specific numbers were
# chosen for this corpus. Only change if you add substantially different
# documents and re-run the diagnostic.
# CHUNK_SIZE=500
# CHUNK_OVERLAP=50

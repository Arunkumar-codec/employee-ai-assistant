# Copy this file to .env and fill in real values locally.
# Never commit .env — it is gitignored.

APP_NAME=Employee AI Assistant
APP_ENV=development
DEBUG=true

API_HOST=0.0.0.0
API_PORT=8000

FRONTEND_ORIGIN=http://localhost:5500

# --- Not used until Day 3+ (LLM answer generation) ---
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=

# --- Not used until Day 2+ (embeddings / vector store) ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHROMA_PERSIST_DIRECTORY=./vector_store

# --- Not used until Day 2+ (retrieval) ---
TOP_K=4
RETRIEVAL_SCORE_THRESHOLD=0.0
